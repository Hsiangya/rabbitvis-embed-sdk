{
  "name": "@rabbitvis/embed-sdk",
  "version": "0.2.0",
  "description": "RabbitVis Partner Hosted Embed browser SDK: mounts the RabbitVis editor in a partner page.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hsiangya/rabbitvis-embed-sdk.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
